# --- LLM: leave BEDROCK_GATEWAY_URL empty to run fully offline (MockLLM) ---
BEDROCK_GATEWAY_URL=            # e.g. https://llm-gateway.bank.internal/bedrock/v1/messages
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_API_KEY=                # injected as "Authorization: Bearer <key>"
BEDROCK_AUTH_HEADER=Authorization

# --- Database: SQLite by default; PostgreSQL recommended in production ---
TSP_DATABASE_URL=               # e.g. postgresql+psycopg://tsp:secret@db:5432/termsheets

# --- Agent tuning ---
TSP_MAX_CRITIC_ITERATIONS=3
TSP_LESSON_TOP_K=6
