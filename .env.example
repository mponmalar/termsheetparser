# --- LLM provider: gateway | bedrock | mock | auto (default) ---------------
# auto = gateway if BEDROCK_GATEWAY_URL set, else bedrock if AWS region set,
# else mock (fully offline).
TSP_LLM_PROVIDER=auto
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Provider "gateway" — bank-hosted Bedrock gateway (HTTP + API key)
BEDROCK_GATEWAY_URL=            # e.g. https://llm-gateway.bank.internal/bedrock/v1/messages
BEDROCK_API_KEY=                # injected as "Authorization: Bearer <key>"
BEDROCK_AUTH_HEADER=Authorization

# Provider "bedrock" — direct AWS Bedrock via boto3 (SigV4 / IAM)
# Credentials come from the standard AWS chain (env keys, AWS_PROFILE,
# ~/.aws/credentials, or an instance/ECS role) — do not put them here.
BEDROCK_REGION=                 # e.g. ap-southeast-1 (or set AWS_REGION)
BEDROCK_ENDPOINT_URL=           # optional bedrock-runtime VPC endpoint

# --- Database: SQLite by default; PostgreSQL recommended in production ---
TSP_DATABASE_URL=               # e.g. postgresql+psycopg://tsp:secret@db:5432/termsheets

# --- Agent tuning ---
TSP_MAX_CRITIC_ITERATIONS=3
TSP_LESSON_TOP_K=6
