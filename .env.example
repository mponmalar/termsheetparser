# =============================================================================
#  Term Sheet Parser — local configuration
#  Edit this file and restart the server for changes to take effect.
#  This file is git-ignored — never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TSP_HOST=127.0.0.1
# TSP_HOST=0.0.0.0    ← uncomment to expose on the local network

TSP_PORT=8000

# Hot-reload on code changes. Set to false in production.
TSP_RELOAD=true

# uvicorn log level: debug | info | warning | error
TSP_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database
# Leave blank for SQLite (./data/termsheets.db) — zero setup.
# Uncomment and fill for PostgreSQL in production.
# -----------------------------------------------------------------------------
TSP_DATABASE_URL=
# TSP_DATABASE_URL=postgresql+psycopg://tsp:secret@localhost:5432/termsheets

# -----------------------------------------------------------------------------
# LLM provider
# bedrock_key — AWS Bedrock long-term API key (AWS Console → Bedrock → API keys)
#               Easiest option: just set BEDROCK_API_KEY + BEDROCK_REGION. No IAM needed.
# gateway     — bank-hosted HTTP Bedrock gateway (needs BEDROCK_GATEWAY_URL + BEDROCK_API_KEY)
# bedrock     — direct AWS boto3 / SigV4 (needs BEDROCK_REGION + IAM credentials)
# mock        — deterministic offline extractor (dev / CI / demo)
# auto        — bedrock_key if BEDROCK_API_KEY+BEDROCK_REGION set,
#               else gateway if BEDROCK_GATEWAY_URL set,
#               else bedrock if BEDROCK_REGION set, else mock
# -----------------------------------------------------------------------------
TSP_LLM_PROVIDER=auto

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4000

# -- Gateway provider (bank-hosted HTTP endpoint) --
# Fill in BEDROCK_GATEWAY_URL and BEDROCK_API_KEY, set TSP_LLM_PROVIDER=gateway
BEDROCK_GATEWAY_URL=
BEDROCK_API_KEY=
BEDROCK_AUTH_HEADER=Authorization

# -- Direct Bedrock provider (boto3 / SigV4) --
# Fill in BEDROCK_REGION, set TSP_LLM_PROVIDER=bedrock
# AWS credentials are resolved in this order:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below
#   2. AWS_PROFILE  (uses ~/.aws/credentials named profile)
#   3. ~/.aws/credentials [default] profile  (run: aws configure)
#   4. EC2 / ECS / EKS instance role  (recommended in production)
BEDROCK_REGION=
# BEDROCK_REGION=ap-southeast-1

BEDROCK_ENDPOINT_URL=
# BEDROCK_ENDPOINT_URL=https://vpce-xxx.bedrock-runtime.ap-southeast-1.vpce.amazonaws.com

# AWS credentials (leave blank if using ~/.aws/credentials or an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For temporary credentials / SSO:
AWS_SESSION_TOKEN=

# AWS named profile (alternative to access keys)
# AWS_PROFILE=my-bedrock-profile

# -----------------------------------------------------------------------------
# Agent tuning
# -----------------------------------------------------------------------------
# Max Extraction <-> Critic loop iterations before accepting best result
TSP_MAX_CRITIC_ITERATIONS=3

# Number of past lessons retrieved and injected into each extraction prompt
TSP_LESSON_TOP_K=6

TSP_LESSON_MIN_SIMILARITY=0.05
