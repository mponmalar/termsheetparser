# =============================================================================
#  Term Sheet Parser — local configuration
#  Copy this file to .env, fill in the values you need, and restart the app.
#  .env is git-ignored — never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TSP_HOST=127.0.0.1       # bind address (0.0.0.0 to expose on the network)
TSP_PORT=8000
TSP_RELOAD=true          # hot-reload on code changes; set false in production
TSP_LOG_LEVEL=info       # uvicorn log level: debug | info | warning | error

# -----------------------------------------------------------------------------
# Database
# Default: SQLite inside ./data/ (zero setup, fine for a single workstation).
# Production: PostgreSQL with pgvector.
# -----------------------------------------------------------------------------
TSP_DATABASE_URL=        # leave blank → SQLite
# TSP_DATABASE_URL=postgresql+psycopg://tsp:secret@localhost:5432/termsheets

TSP_DATA_DIR=            # leave blank → ./data/

# -----------------------------------------------------------------------------
# LLM access
# TSP_LLM_PROVIDER = auto | gateway | bedrock | mock
#   auto    — gateway if BEDROCK_GATEWAY_URL is set, else bedrock if
#             BEDROCK_REGION is set, else mock (offline).
#   gateway — bank-hosted Bedrock gateway (HTTP + API key, messages-API shape).
#   bedrock — direct AWS Bedrock via boto3 / SigV4 (needs BEDROCK_REGION +
#             AWS credentials in the standard chain; pip install boto3).
#   mock    — deterministic offline extractor (dev / CI / demo).
# -----------------------------------------------------------------------------
TSP_LLM_PROVIDER=auto

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4000

# Provider: gateway — bank-hosted HTTP endpoint (uses its own API key)
BEDROCK_GATEWAY_URL=     # e.g. https://llm-gw.bank.internal/bedrock/v1/messages
BEDROCK_API_KEY=         # forwarded as "Authorization: Bearer <key>"
BEDROCK_AUTH_HEADER=Authorization

# Provider: bedrock — direct AWS Bedrock via boto3 + SigV4
# SigV4 signs every request automatically; there is NO separate API key.
# boto3 resolves credentials in this order (first match wins):
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below  (local dev)
#   2. AWS_PROFILE + ~/.aws/credentials                  (named profile)
#   3. ~/.aws/credentials [default] profile              (aws configure)
#   4. EC2 / ECS / EKS instance role                     (production — preferred)
BEDROCK_REGION=          # e.g. ap-southeast-1  (or set AWS_REGION)
BEDROCK_ENDPOINT_URL=    # optional bedrock-runtime VPC endpoint

# AWS credentials — only needed for TSP_LLM_PROVIDER=bedrock on a machine
# without an IAM role or configured ~/.aws profile.
# Leave blank if using ~/.aws/credentials, AWS_PROFILE, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=       # only for temporary credentials / SSO / MFA

# -----------------------------------------------------------------------------
# Agent tuning
# -----------------------------------------------------------------------------
TSP_MAX_CRITIC_ITERATIONS=3   # Extraction <-> Critic loop budget
TSP_LESSON_TOP_K=6            # lessons retrieved and injected per extraction
TSP_LESSON_MIN_SIMILARITY=0.05
